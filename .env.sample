# Copy to .env and fill in. Never commit .env. An empty value means "not configured".

# --- Core ---------------------------------------------------------------------------------------------------------
APP_ENV=dev                                  # dev | test | prod (prod switches logs to JSON)
LOG_LEVEL=INFO
# Matches compose.yaml (local development only; host port 5433). A plain postgresql:// URL is switched to asyncpg.
DATABASE_URL=postgresql://tg_discovery:tg_discovery@localhost:5433/tg_discovery

# --- Service ------------------------------------------------------------------------------------------------------
# When set, every API call must carry it as "Authorization: Bearer <token>" plus X-Admin-Id and X-Admin-Role
# (viewer | reviewer | runner). Leave it empty only in development: the API is then open and Swagger works as it is.
SERVICE_TOKEN=
# Providers whose vendor terms were accepted, by name; SerpApi does not run otherwise. SerpApi is Google-derived data,
# a legal grey area: ACCEPTED_TERMS=serpapi_events,serpapi_maps
ACCEPTED_TERMS=
# Which providers a run may use; empty means every provider that has a key and whose terms were accepted.
# Names: exa, serpapi_events, serpapi_maps, osm_overpass.
PROVIDERS_ENABLED=
BUDGET_USD_PER_RUN=1.0                       # a run stops searching before it would spend more than this (cap 50)
RUN_TTL_EVENT_HOURS=3                        # an identical request is answered by the finished run for this long
RUN_TTL_VENUE_HOURS=168
CITY_RADIUS_KM=15                            # the area searched around a city centre
FETCH_EVENT_PICTURES=true                    # read the pages events came from for their picture URLs (robots.txt honoured)
# Keep the phone, opening hours, description and price that Google shows (SerpApi). Off by default: Google's terms do
# not allow storing them and Google v. SerpApi is pending, so Google-derived data keeps only names, addresses,
# coordinates, URLs and ids. Needs legal sign-off before such data is published.
KEEP_GOOGLE_DETAILS=false

# --- LLM: Bedrock, OpenAI-compatible Responses API (shared extractor) -----------------------------------------------
AWS_BEDROCK_API_TOKEN=
# Base URL including the model's path prefix, e.g. https://bedrock-mantle.us-west-2.api.aws/v1 for gpt-oss models
# and .../openai/v1 for gpt-5.x; the prefix differs per model, so smoke-test a new one first.
AWS_BEDROCK_OPENAI_URL=
EXTRACTOR_MODEL_ID=openai.gpt-oss-120b
# List prices, not verified on the Bedrock price page:
# EXTRACTOR_INPUT_USD_PER_1M_TOKENS=0.15
# EXTRACTOR_OUTPUT_USD_PER_1M_TOKENS=0.60
# Reasoning effort sent with each extraction call (low | medium | high | none); "none" omits the parameter.
# EXTRACTOR_REASONING_EFFORT=low
# EXTRACTOR_MAX_OUTPUT_TOKENS=8192
# Per-call timeout in seconds (10 to 900); a timed-out call is not retried.
# EXTRACTOR_TIMEOUT_S=240
# Debugging: log the first N characters of each page sent to the model (0 = off, at most 6000).
# LOG_PAGE_TEXT_CHARS=500
# gpt-oss on Bedrock rejects a named tool_choice, so "auto" is used; set true only for a model that accepts one.
# EXTRACTOR_FORCED_TOOL_CHOICE=false

# --- Search providers (a provider without a key is skipped) ---------------------------------------------------------
EXA_API_KEY=
# SerpApi: the events pack of Google Search (events) and Google Maps (venues). Google-derived data: it runs only when
# listed in ACCEPTED_TERMS.
SERPAPI_API_KEY=

# --- OpenStreetMap ----------------------------------------------------------------------------------------------------
# Identifies this application to Nominatim and the public Overpass instances (their usage policies require it).
NOMINATIM_USER_AGENT="tg-discovery/0.1 (contact: admin@example.com)"
